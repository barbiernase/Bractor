<!-- Host.Blazor/Host.Blazor.csproj -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastruktur: Bus, Startup, Connection — für DI-Setup in Program.cs -->
    <ProjectReference Include="..\Client.Infrastructure\Client.Infrastructure.csproj" />
    <!-- GUI-Struktur + Domain-Sicht: das modulare Frontend (löste die alten
         Domain.Client / Domain.Client.Ui.Blazor ab, 2026-08-12). -->
    <ProjectReference Include="..\Domain.Client.Modules.Blazor\Domain.Client.Modules.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MudBlazor: Host braucht AddMudServices() + CSS/JS aus _Host.cshtml -->
    <PackageReference Include="MudBlazor" Version="9.3.0" />
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Shell\" />
  </ItemGroup>

</Project>