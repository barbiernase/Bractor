@page "/"
@namespace Host.Blazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ImagePair — Labeling</title>
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <style>
        html, body { margin: 0; padding: 0; background: #121212; color: #e0e0e0; font-family: Roboto, sans-serif; }

        /* Bühnen (MudTabs-Panels) füllen die volle Höhe der Tab-Fläche. Ohne das reicht
           MudTabs die begrenzte Shell-Höhe nicht durch → eine scrollbare Stage (z. B. die
           Galerie mit ihren Virtualisierungs-Spacern) dehnt die Seite statt intern zu scrollen. */
        .mud-tabs { height: 100%; display: flex; flex-direction: column; min-height: 0; }
        .mud-tabs-panels { flex: 1 1 auto; min-height: 0; overflow: hidden; }
        .mud-tabs-panels > .mud-tab-panel { height: 100%; min-height: 0; }
    </style>
</head>
<body>
<component type="typeof(Host.Blazor.App)" render-mode="ServerPrerendered" />
<script src="_framework/blazor.server.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
