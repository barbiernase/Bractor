<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);VERTRAG_INTERN</DefineConstants>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 (Analyzer-Release-Tracking) ist für die internen CQRS-Diagnostiken nicht nötig. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Die Aggregat-Namensregel aus dem Vertrag (eine Quelle mit dem Domänen-Extractor). -->
    <Compile Include="..\Abstractions\Aggregatvertrag.cs" Link="Vertrag\Aggregatvertrag.cs" />
    <Compile Include="..\Abstractions\Idvertrag.cs" Link="Vertrag\Idvertrag.cs" />
    <Compile Include="..\Abstractions\Funktionsvertrag.cs" Link="Vertrag\Funktionsvertrag.cs" />
    <Compile Include="..\Abstractions\Projektionsvertrag.cs" Link="Vertrag\Projektionsvertrag.cs" />
    <Compile Include="..\Abstractions\Dienstvertrag.cs" Link="Vertrag\Dienstvertrag.cs" />
    <Compile Include="..\Abstractions\Clientvertragsregeln.cs" Link="Vertrag\Clientvertragsregeln.cs" />
    <Compile Include="..\Abstractions\Quellen\Treibervertrag.cs" Link="Vertrag\Treibervertrag.cs" />
    <Compile Include="..\Abstractions\Projektstruktur.cs" Link="Vertrag\Projektstruktur.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
   <Compile Include="..\Core.SourceGeneration\*.cs" Link="Shared\%(FileName).cs" />

    <!-- Also need Abstractions -->
    <Compile Include="..\Abstractions.SourceGeneration\*.cs" Link="Shared\%(FileName).cs" />
  </ItemGroup>
  

</Project>