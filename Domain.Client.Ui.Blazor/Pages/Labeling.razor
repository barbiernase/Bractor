@page "/labeling"

<div tabindex="0"
     @ref="Container"
     @onkeydown="OnKeyDown"
     @onkeydown:preventDefault
     style="outline: none; height: 100vh; display: flex; flex-direction: column; background: #121212; color: #e0e0e0;">

    <GlobalEffects />
    <HeaderSection OnSettingsClick="OpenSettings" />

    <div style="flex: 1; display: flex; min-height: 0;">
        @if (PaarlisteAktiv)
        {
            <PaarlisteSection IsExpanded="PaarlisteOffen"
                              IsExpandedChanged="SetPaarlisteOffen" />
        }

        <StageSection BilderAktiv="BilderStageAktiv"
                      DebugAktiv="DebugStageAktiv"
                      ChartAktiv="ChartStageAktiv" />

        @if (HistoriePanelAktiv)
        {
            <HistorieSection IsExpanded="HistoriePanelOffen"
                             IsExpandedChanged="SetHistoriePanelOffen" />
        }
    </div>

    <FooterBar />
</div>

<MudDialog @bind-Visible="SettingsOffen" Options="DialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Einstellungen</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #888;">Sidebars</MudText>
        <MudCheckBox T="bool" @bind-Value="PaarlisteAktiv" Label="Paarliste" Color="Color.Primary" Dense="true" />
        <MudCheckBox T="bool" @bind-Value="HistoriePanelAktiv" Label="Historie" Color="Color.Primary" Dense="true" />
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #888;">Stages</MudText>
        <MudCheckBox T="bool" @bind-Value="BilderStageAktiv" Label="Bilder (DC0/DC2)" Color="Color.Primary" Dense="true" />
        <MudCheckBox T="bool" @bind-Value="DebugStageAktiv" Label="Debug-Stage" Color="Color.Primary" Dense="true" />
        <MudCheckBox T="bool" @bind-Value="ChartStageAktiv" Label="Chart (Produktionsverlauf)" Color="Color.Primary" Dense="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseSettings" Color="Color.Primary">Schließen</MudButton>
    </DialogActions>
</MudDialog>
