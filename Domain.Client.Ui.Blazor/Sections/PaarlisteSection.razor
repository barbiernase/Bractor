<PanelFrame Title="Paarliste"
            IsExpanded="IsExpanded"
            IsExpandedChanged="IsExpandedChanged"
            Side="PanelFrame.PanelSide.Left"
            ExpandedWidth="180" CollapsedWidth="40">
    <PaarlistenPanel IsExpanded="IsExpanded"
                     Items="Items"
                     SelectedIndex="SelectedIndex"
                     FilterWert="FilterWert"
                     NurNichtInspizierte="NurNichtInspizierte"
                     Seite="Seite"
                     GesamtSeiten="GesamtSeiten"
                     OnSelect="SelectPair"
                     OnFilterChanged="ChangeFilter"
                     OnNurNeueChanged="ToggleInspektionsFilter"
                     OnVorige="VorigeSeite"
                     OnNaechste="NaechsteSeite" />
</PanelFrame>
