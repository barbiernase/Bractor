<Project Sdk="Microsoft.NET.Sdk">
  <!-- Der Worker der Reaktionen der Prüfdomäne (docs/konzept-akteure.md §5.5): ein Client, der auf Fakten reagiert — er hört Events und gibt den
       Command an den Kopf eines Graphen, genau einmal über seinen gesicherten Stand. Kein Teil des Hosts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Client.Infrastructure\Client.Infrastructure.csproj" />
    <ProjectReference Include="..\Pruefdomaene\Pruefdomaene.csproj" />
    <ProjectReference Include="..\Pruefdomaene.Akteure\Pruefdomaene.Akteure.csproj" />
    <ProjectReference Include="..\Pruefdomaene.Leitung\Pruefdomaene.Leitung.csproj" />
    <ProjectReference Include="..\Client.SourceGeneration\Client.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
