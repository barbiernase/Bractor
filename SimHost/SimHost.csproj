<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Der Wissensgraph liegt neben der .sln; wir lesen ihn zur Laufzeit. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- KEINE Domain-Referenz: simuliert wird ausschließlich das Editor-Modell (In-Memory-Kompilat mit den
         echten Domain-Generatoren) — sonst gäbe es zwei Wahrheiten (verlinkte Domain.dll vs. Modell). -->
    <!-- Core: Framework-Basis der generierten Handler (AggregateHandlerBase) — Laufzeit-Referenz des Kompilats. -->
    <ProjectReference Include="../Core/Core.csproj" />
    <!-- Der DSL-Schreiber (nur Abstractions-Ref): Board-Session → Test-Quelltext. -->
    <ProjectReference Include="../Cqrs.Testing/Cqrs.Testing.csproj" />
    <!-- Der Editor-Modus: reiner Scaffolder/Validator (keine Roslyn/Infra) — Modell → C#, live. -->
    <ProjectReference Include="../DomainEditor/DomainEditor.csproj" />
    <!-- Live-Kompilat: das getippte Modell IN-MEMORY mit den ECHTEN Domain-Generatoren übersetzen
         und über den store-freien Kern ausführen — kein Proto, keine Platte, kein Neustart. -->
    <ProjectReference Include="../Domain.SourceGeneration/Domain.SourceGeneration.csproj"
                      OutputItemType="none" ReferenceOutputAssembly="true" />
    <!-- Store-Regeln (CQRS066/067) für die Prüfung eines Store-Rumpfs vor dem Schreiben (ProjektPruefung). -->
    <ProjectReference Include="../Projections.SourceGeneration/Projections.SourceGeneration.csproj"
                      OutputItemType="none" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dieselbe Roslyn-Version wie der Extractor-Kern (warmer Workspace). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <!-- Marten (über Core) zieht Roslyn 4.14 für seinen Laufzeit-Compiler — in SimHost läuft er nie; dieselbe Version für alles (sonst NU1608). -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.3.0" />
    <!-- MSBuildLocator zur Laufzeit; die MSBuild-Assemblies selbst kommen aus dem SDK, nicht aus der Ausgabe. -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Werkbank: Sim-DB verwalten (zurücksetzen, Stände speichern/laden). -->
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Der Extractor-Kern: warmer Workspace (Arbeitsbereich, Werkbank P7.1) und dieselben Feld-Regeln wie der Extractor
         (Codeformen: Code → Modell) für den Abgleich bestehender Deklarationen (Modell → Code). -->
    <ProjectReference Include="../GraphExtractor.Kern/GraphExtractor.Kern.csproj" />
  </ItemGroup>
</Project>
