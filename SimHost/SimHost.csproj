<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Der Wissensgraph liegt neben der .sln; wir lesen ihn zur Laufzeit. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- NUR Domain: dort liegen (generiert) AggregateHandlerFactory + GeneratedProzessRegeln.
         Kein Marten, kein Proto.Actor, kein Infrastructure — die reine, single-threaded Ausführung. -->
    <ProjectReference Include="../Domain/Domain.csproj" />
    <!-- Der DSL-Schreiber (nur Abstractions-Ref): Board-Session → Test-Quelltext. -->
    <ProjectReference Include="../Cqrs.Testing/Cqrs.Testing.csproj" />
    <!-- Der Editor-Modus: reiner Scaffolder/Validator (keine Roslyn/Infra) — Modell → C#, live. -->
    <ProjectReference Include="../DomainEditor/DomainEditor.csproj" />
    <!-- Live-Kompilat: das getippte Modell IN-MEMORY mit den ECHTEN Domain-Generatoren übersetzen
         und über den store-freien Kern ausführen — kein Proto, keine Platte, kein Neustart. -->
    <ProjectReference Include="../Domain.SourceGeneration/Domain.SourceGeneration.csproj"
                      OutputItemType="none" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
