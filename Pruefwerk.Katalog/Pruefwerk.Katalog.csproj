<Project Sdk="Microsoft.NET.Sdk">

    <!-- Ein Funktionskatalog (docs/plan-ohne-pipeline.md): die Funktionen und Graphen, an denen die Prüfdomäne das Framework prüft — Freigabe und Mahnung,
         Import als Strom, Merkmalbildung mit Zustand und Lese-Fähigkeit. Domänenneutral: er referenziert nur Abstractions, nie eine Anwendung; was daraus
         in der Prüfdomäne wird, sagen ihre Übersetzungen. -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Domain.SourceGeneration\Domain.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    </ItemGroup>

</Project>
