<Project Sdk="Microsoft.NET.Sdk">

  <!-- Die Stores der Prüfdomäne (docs/07, Rolle Speicher): ein Datei-Ziel der Klasse 2 und eine Datei-Senke der Klasse 3 — der Nachweis, dass das
       Framework hinter derselben Naht keine Transaktion des Stores braucht (Plan Pub/Sub-Neustrukturierung §2.4, Phase 8). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pruefdomaene.Projections\Pruefdomaene.Projections.csproj" />
    <ProjectReference Include="..\Pruefdomaene\Pruefdomaene.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Projections.SourceGeneration\Projections.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
