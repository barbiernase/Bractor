@namespace Domain.Client.Modules.Blazor.Galerie
@inject Store Store
@inject EffectScope Fx
@using global::Client.Infrastructure.Abstractions
@using Domain.Client.Modules
@using Domain.Client.Modules.Blazor.Shared
@using Domain.Client.Modules.Kuratieren
@using Domain.ImagePair
@implements IDisposable

@*
    Bühne „Galerie" — reine Galerie-Ansicht (keine Detail-Vorschau). Thumbnail-Grid über
    demselben VirtualImagePairs-Fenster wie die Paarliste. Die Zellen orientieren sich an den
    Bildern (Seitenverhältnis), die Spaltenzahl ist steuerbar. Auswahl teilt sich den Cursor mit
    Paarliste + Bild-Bühne. „Enter" (Modul-Keybinding) oder Doppelklick wechselt ins Bild.
*@

<div style="display:flex;flex-direction:column;height:100%;min-height:0;overflow:hidden">

    @* ── Werkzeugleiste: Bilder pro Reihe ── *@
    <div style="flex:0 0 auto;display:flex;align-items:center;gap:8px;padding:6px 10px;
                border-bottom:1px solid #333;font-size:12px;color:#bbb">
        <span>Bilder pro Reihe:</span>
        <button style="@BtnStyle" @onclick="Weniger" disabled="@(_columns <= MinCols)">−</button>
        <span style="min-width:20px;text-align:center;color:#eee">@_columns</span>
        <button style="@BtnStyle" @onclick="Mehr" disabled="@(_columns >= MaxCols)">+</button>

        <span style="width:10px"></span>
        <button style="@AuswahlBtnStyle" @onclick="ToggleAuswahl"
                title="Rubber-Band: Rechteck über die Kacheln ziehen; Klick togglet eine Kachel">
            @(_auswahlModus ? "✓ Auswahl-Modus" : "Mehrfach-Auswahl")
        </button>
        @if (_auswahlModus)
        {
            <span style="color:#8ab4f8">@Store.Markierung.Count markiert</span>
            <button style="@PrimaryBtnStyle" @onclick="AuswahlAufnehmen" disabled="@(!KannAufnehmen)">
                ＋ ins Sammel-Ziel
            </button>
            <button style="@BtnStyle" @onclick="AuswahlLeeren" disabled="@(Store.Markierung.Count == 0)">leeren</button>
        }

        <span style="margin-left:auto;color:#666">@Store.VirtualImagePairs.GesamtAnzahl Paare · Enter/Doppelklick → Bild</span>
    </div>

    @* ── Datensatz-Fokus: Alle · Nur dieser Datensatz · Ausgeschlossene ── *@
    @if (Store.SammelZiel is { } ziel)
    {
        <div style="flex:0 0 auto;display:flex;align-items:center;gap:8px;padding:6px 10px;
                    background:#181422;border-bottom:1px solid #333;font-size:12px;color:#bbb">
            <span style="color:#cbb8f0;font-weight:600">@Kurz(ziel.Name)</span>
            <span style="color:#666">Zeige:</span>
            <button style="@ModusStil(DatensatzGalerieModus.Aus)"          @onclick="() => SetzeModus(DatensatzGalerieModus.Aus)">Alle</button>
            <button style="@ModusStil(DatensatzGalerieModus.Mitglieder)"   @onclick="() => SetzeModus(DatensatzGalerieModus.Mitglieder)">Nur dieser Datensatz (@ziel.AnzahlMitglieder)</button>
            <button style="@ModusStil(DatensatzGalerieModus.Ausgeschlossen)" @onclick="() => SetzeModus(DatensatzGalerieModus.Ausgeschlossen)">Ausgeschlossene (@ziel.AnzahlAusgeschlossen)</button>
            @if (Store.DatensatzGalerieModus != DatensatzGalerieModus.Aus)
            {
                <button style="@BtnStyle" @onclick="ZurVerwaltung" title="zurück zur Datensatz-Verwaltung">→ Verwalten</button>
            }
        </div>
    }

    @* ── Grid ── *@
    <div style="flex:1;min-height:0;overflow:hidden">
        <VirtualGrid TItem="ImagePairRecord" TKey="Guid"
                     Store="Store" Window="Store.VirtualImagePairs" Cursor="Store.Cursor"
                     Columns="_columns" AspectRatio="7.46"
                     OnActivate="Auswaehlen" OnOpen="Oeffnen"
                     SelectionMode="_auswahlModus" OnBandSelect="BandSelected">
            <Cell Context="rec">
                <div style="height:100%;padding:2px;box-sizing:border-box">
                    <div style="height:100%;background:#111;border-radius:3px;overflow:hidden;
                                position:relative;display:flex;align-items:center;justify-content:center">
                        @if (rec.Dc0BildSrc != null)
                        {
                            <img src="@rec.Dc0BildSrc" loading="lazy" alt="@rec.PairKey"
                                 style="width:100%;height:100%;object-fit:contain" />
                        }
                        else
                        {
                            <span style="color:#444;font-size:10px">
                                @(rec.Dc0Pfad != null ? "…" : "kein Bild")
                            </span>
                        }

                        @if (LabelVon(rec) is { } label)
                        {
                            <span title="@label"
                                  style="position:absolute;top:3px;right:3px;width:9px;height:9px;
                                         border-radius:50%;border:1px solid #000;background:@Farbe(label)"></span>
                        }

                        @* Datensatz-Tag: Mitgliedschafts-Badge + Klick-Toggle (Konzept §4.2). *@
                        @if (Store.SammelZiel is { IstEingefroren: false })
                        {
                            var drin = Store.IstMitglied(rec.Id);
                            <span @onclick="() => Toggle(rec)" @onclick:stopPropagation="true"
                                  title="@(drin ? "Aus Sammel-Ziel entfernen" : "Ins Sammel-Ziel aufnehmen")"
                                  style="position:absolute;top:3px;left:4px;width:16px;height:16px;border-radius:50%;
                                         cursor:pointer;text-align:center;line-height:15px;font-size:11px;
                                         @(drin ? "background:#7e57c2;color:#fff;border:1px solid #0006"
                                                : "background:#0007;color:#b39ddb;border:1px dashed #7e57c2")">
                                @(drin ? "✓" : "+")
                            </span>
                        }
                        else if (Store.IstMitglied(rec.Id))
                        {
                            <span title="im Sammel-Ziel"
                                  style="position:absolute;top:3px;left:4px;width:14px;height:14px;border-radius:50%;
                                         background:#7e57c2;color:#fff;text-align:center;line-height:13px;font-size:10px;border:1px solid #0006">✓</span>
                        }

                        @* Dedizierte Markierung (Rubber-Band-Auswahl) — unabhängig von der Mitgliedschaft. *@
                        @if (Store.IstMarkiert(rec.Id))
                        {
                            <span title="markiert"
                                  style="position:absolute;bottom:3px;right:3px;width:15px;height:15px;border-radius:3px;
                                         background:#0009;border:1px solid #5c9eff;color:#8ab4f8;font-size:10px;
                                         line-height:13px;text-align:center">✓</span>
                        }

                        @if (!rec.IstKomplett)
                        {
                            <span style="position:absolute;bottom:2px;left:4px;font-size:9px;color:#c9a227">unvollständig</span>
                        }
                    </div>
                </div>
            </Cell>
            <Skeleton>
                <div style="height:100%;padding:2px;box-sizing:border-box">
                    <div style="height:100%;background:#161616;border-radius:3px"></div>
                </div>
            </Skeleton>
        </VirtualGrid>
    </div>

</div>

@code {
    private const int MinCols = 1;
    private const int MaxCols = 12;
    private int _columns = 3;
    private bool _auswahlModus;

    private bool KannAufnehmen => Store.SammelZiel is { IstEingefroren: false } && Store.Markierung.Count > 0;

    private const string BtnStyle =
        "height:22px;padding:0 6px;min-width:22px;border:1px solid #444;background:#222;color:#ddd;border-radius:3px;cursor:pointer;line-height:1";
    private string AuswahlBtnStyle =>
        "height:22px;padding:0 10px;border-radius:3px;cursor:pointer;line-height:1;font-size:12px;" +
        (_auswahlModus ? "border:1px solid #5c9eff;background:#12233a;color:#bcd8ff"
                       : "border:1px solid #444;background:#222;color:#ddd");
    private const string PrimaryBtnStyle =
        "height:22px;padding:0 10px;border:1px solid #7e57c2;background:#2a2140;color:#cbb8f0;border-radius:3px;cursor:pointer;line-height:1;font-size:12px";

    protected override void OnInitialized()
    {
        Fx.OnChanged(Store, Store.VirtualImagePairs, LadeThumbnails);
        // Mitgliedschafts-Badges folgen dem Sammel-Ziel: bei jeder Store-Änderung neu rendern
        // (SammelZiel-Wechsel, Tag-Toggle). Re-Render fließt in die VirtualGrid-Cells durch.
        Fx.OnChanged(Store, () => InvokeAsync(StateHasChanged));
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Erststoß: beim Tab-Wechsel ist das Fenster i.d.R. schon von der Paarliste geladen und
        // versioniert nicht mehr → der OnChanged-Effekt allein würde nie feuern.
        if (firstRender) LadeThumbnails();
    }

    private void Mehr()    { if (_columns < MaxCols) _columns++; }
    private void Weniger() { if (_columns > MinCols) _columns--; }

    // Einfacher Klick: Auswahl (Cursor) — Paarliste + (spätere) Bild-Bühne folgen.
    private void Auswaehlen(ImagePairRecord rec) => Fx.Dispatch(new ImagePairAusgewaehlt(rec.Id));

    // Klick auf das Tag-Badge: Mitgliedschaft im aktiven Sammel-Ziel umschalten (ohne Cursor-Wechsel).
    private void Toggle(ImagePairRecord rec) => Fx.Dispatch(new DatensatzTagGetoggelt(rec.Id));

    // ── Dedizierte Mehrfach-Auswahl ──
    private void ToggleAuswahl() => _auswahlModus = !_auswahlModus;

    // Rubber-Band abgeschlossen: 1 Item = Klick → togglen; mehrere = Bereich zur Markierung.
    private void BandSelected(IReadOnlyList<ImagePairRecord> items)
    {
        if (items.Count == 1)
            Fx.Dispatch(new MarkierungGetoggelt(items[0].Id));
        else if (items.Count > 1)
            Fx.Dispatch(new MarkierungBereichHinzugefuegt(items.Select(r => r.Id).ToList()));
    }

    private void AuswahlAufnehmen() => Fx.Dispatch(new AuswahlAufgenommenAngefordert());
    private void AuswahlLeeren()    => Fx.Dispatch(new MarkierungGeleert());

    // ── Datensatz-Fokus (Galerie zeigt Alle / Mitglieder / Ausgeschlossene) ──
    private void SetzeModus(DatensatzGalerieModus m) => Fx.Dispatch(new DatensatzGalerieModusGesetzt(m));
    private void ZurVerwaltung() => Fx.Dispatch(new StageWechselAngefordert("datensatz-komposition"));

    private string ModusStil(DatensatzGalerieModus m)
    {
        var aktiv = Store.DatensatzGalerieModus == m;
        return "height:22px;padding:0 10px;border-radius:11px;cursor:pointer;line-height:1;font-size:12px;" +
               (aktiv ? "border:1px solid #7e57c2;background:#2a2140;color:#cbb8f0"
                      : "border:1px solid #444;background:#222;color:#ccc");
    }

    private static string Kurz(string? name)
    {
        var n = string.IsNullOrWhiteSpace(name) ? "Sammel-Ziel" : name!.Trim();
        return n.Length > 24 ? n[..23] + "…" : n;
    }

    // Doppelklick: auswählen UND ins Bild wechseln (wie Enter).
    private void Oeffnen(ImagePairRecord rec)
    {
        Fx.Dispatch(new ImagePairAusgewaehlt(rec.Id));
        Fx.Dispatch(new StageWechselAngefordert("bilder"));
    }

    // Thumbnails nur für die GELADENEN Records laden (Virtualisierung begrenzt die Menge).
    // FileBridge dedupt inflight; nach FileLoaded patcht der Store BildSrc → Fenster versioniert
    // → dieser Effekt feuert erneut und überspringt die schon geladenen.
    private void LadeThumbnails()
    {
        foreach (var rec in Store.VirtualImagePairs.AlleGeladenen())
            if (rec.Dc0Pfad is not null && rec.Dc0BildSrc is null)
                Fx.Dispatch(new LoadFile(rec.Dc0Pfad));
    }

    private static Klassifikation? LabelVon(ImagePairRecord r)
        => r.PhysischesProduktLabel ?? r.MenschBildpaarLabel;

    private static string Farbe(Klassifikation label) => label switch
    {
        Klassifikation.Anomalie      => "#e05252",
        Klassifikation.KeineAnomalie => "#4caf50",
        _                            => "#c9a227"
    };

    public void Dispose() => Fx.Dispose();
}
