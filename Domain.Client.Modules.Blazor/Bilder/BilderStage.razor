@inject Store Store
@inject EffectScope Fx
@using global::Client.Infrastructure.Abstractions
@using Domain.Client.Modules.Datensaetze
@using Domain.Datensatz
@using Domain.Projections
@implements IDisposable

@* Aktuelles Paar über den Cursor-Index (stabil + InsertOffset). Ist es noch ein
   Skeleton, ist rec null → Platzhalter, bis der Chunk eintrifft (OnChanged feuert). *@
@{ var rec = Store.Cursor.Id.HasValue
        ? Store.VirtualImagePairs[Store.Cursor.Index + Store.VirtualImagePairs.InsertOffset]
        : null; }

<div style="flex:1;display:flex;flex-direction:column;min-height:0">

    @if (rec == null)
    {
        <div style="flex:1;display:flex;align-items:center;justify-content:center">
            <span style="color:#444">Kein Bildpaar ausgewählt</span>
        </div>
    }
    else
    {
        <div style="flex:1;display:flex;gap:4px;padding:4px;min-height:0">
            <div style="flex:1;display:flex;align-items:center;justify-content:center;background:#111;border-radius:4px;overflow:hidden">
                @if (rec.Dc0BildSrc != null)
                { <img src="@rec.Dc0BildSrc" style="max-width:100%;max-height:100%;object-fit:contain" alt="DC0" /> }
                else { <span style="color:#555;font-size:12px">DC0 — kein Bild</span> }
            </div>
            <div style="flex:1;display:flex;align-items:center;justify-content:center;background:#111;border-radius:4px;overflow:hidden">
                @if (rec.Dc2BildSrc != null)
                { <img src="@rec.Dc2BildSrc" style="max-width:100%;max-height:100%;object-fit:contain" alt="DC2" /> }
                else { <span style="color:#555;font-size:12px">DC2 — kein Bild</span> }
            </div>
        </div>

        @* Rückwärts-Tags: „in Datensätzen: …" (Konzept §4.3). Chip-Klick = dorthin wechseln. *@
        <div style="flex:0 0 auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap;
                    padding:6px 10px;border-top:1px solid #2a2a2a;font-size:11px">
            <span style="color:#888">in Datensätzen:</span>
            @if (Store.PaarTags.Count == 0)
            {
                <span style="color:#555">— in keinem</span>
            }
            else
            {
                @foreach (var tag in Store.PaarTags)
                {
                    var aktiv = Store.SammelZiel?.Id == tag.Id;
                    <span @onclick="() => Wechsle(tag.Id)" title="als Sammel-Ziel aktivieren"
                          style="@ChipStyle(tag, aktiv)">
                        @(string.IsNullOrWhiteSpace(tag.Name) ? "(ohne Name)" : tag.Name)@Suffix(tag)
                    </span>
                }
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Fx.OnChanged(Store, Store.Cursor,            OnCursorChanged);
        Fx.OnChanged(Store, Store.VirtualImagePairs, () => InvokeAsync(StateHasChanged));
        // Rückwärts-Tags bei jeder Store-Änderung neu rendern (PaarTags reassign).
        Fx.OnChanged(Store, () => Store.PaarTags, () => InvokeAsync(StateHasChanged));

        // Rückwärts-Tags cursor-getrieben laden; zusätzlich bei Tag-Mutationen neu holen,
        // weil das Taggen des aktuellen Paars den Cursor NICHT bewegt.
        Fx.On<PaarAufgenommen>(_ => LadeTags());
        Fx.On<PaarEntfernt>(_ => LadeTags());
        Fx.On<PaareAufgenommen>(_ => LadeTags());
    }

    private void OnCursorChanged()
    {
        LadeTags();
        InvokeAsync(StateHasChanged);
    }

    private void LadeTags()
    {
        if (Store.Cursor.Id is { } id)
            Fx.Dispatch(new HoleDatensaetzeFuerPaar(id));
    }

    private void Wechsle(Guid id) => Fx.Dispatch(new DatensatzAusgewaehlt(id));

    private static string Suffix(DatensatzTag t)
        => t.Status == DatensatzStatus.Eingefroren ? $" · v{t.EingefroreneVersion}" : " · Entwurf";

    private static string ChipStyle(DatensatzTag t, bool aktiv)
    {
        var frozen = t.Status == DatensatzStatus.Eingefroren;
        var (border, bg, fg) = frozen
            ? ("#5c9eff", "#12233a", "#bcd8ff")
            : ("#7e57c2", "#2a2140", "#cbb8f0");
        var ring = aktiv ? "box-shadow:0 0 0 2px rgba(126,87,194,.5);" : "";
        return $"border:1px solid {border};background:{bg};color:{fg};border-radius:12px;" +
               $"padding:2px 10px;cursor:pointer;white-space:nowrap;{ring}";
    }

    public void Dispose() => Fx.Dispose();
}
