@namespace Domain.Client.Modules.Blazor.Live
@using global::Client.Infrastructure.Abstractions
@using Domain.Client.Modules
@using Domain.Client.Modules.Modelle
@using Domain.Projections
@inject Store Store
@inject ModellListeStore Modelle
@inject EffectScope Fx
@implements IDisposable

@*
    Live-Leiste: „nimmt auf & klassifiziert mit <aktivem Modell>". Reconception des Live-Modus —
    zeigt Aufnahme-Status + welches Modell die neu einlaufenden Bildpaare klassifiziert.
    Chip-Klick auf „Modelle wählen" führt zur Modelle-Bühne (dort aktiv setzen).
*@

<div style="display:flex;align-items:center;gap:12px;padding:6px 12px;
            background:linear-gradient(90deg,#0e1f16,#161616);border-bottom:1px solid #1f6f3a;font-size:12px;color:#bbb">

    @{ var live = Store.IstLive; var aktiv = Aktives(); }

    <span title="@(live ? "Live: nimmt auf" : "nicht im Live-Modus")"
          style="width:10px;height:10px;border-radius:50%;flex:0 0 auto;
                 background:@(live ? "#4caf50" : "#666");
                 box-shadow:@(live ? "0 0 0 4px rgba(76,175,80,.18)" : "none")"></span>
    <span style="color:#ccc;font-weight:600">@(live ? "Live" : "Pausiert")</span>

    <span style="color:#555">·</span>
    <span style="color:#888">klassifiziert mit</span>
    @if (aktiv is { } m)
    {
        <span title="aktives Modell" style="color:#c6f6d5;font-weight:600">@Name(m)</span>
        <span style="color:#888">(@Prozent(m.Genauigkeit))</span>
    }
    else
    {
        <span style="color:#e0a05a">— kein aktives Modell</span>
        <button @onclick="ZuModelle"
                style="background:#12233a;color:#bcd8ff;border:1px solid #5c9eff;border-radius:5px;padding:2px 9px;font-size:11px;cursor:pointer">Modell wählen →</button>
    }

    <div style="flex:1"></div>
    <span style="color:#777">@Store.VirtualImagePairs.GesamtAnzahl Paare</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Fx.OnChanged(Modelle, () => InvokeAsync(StateHasChanged));
        Fx.OnChanged(Store, () => (Store.Modus, Store.VirtualImagePairs.Version), () => InvokeAsync(StateHasChanged));
    }

    private ModellAntwort? Aktives() => Modelle.Modelle.FirstOrDefault(m => m.IstAktiv);

    private void ZuModelle() => Fx.Dispatch(new StageWechselAngefordert("modelle"));

    private static string Name(ModellAntwort m) => string.IsNullOrWhiteSpace(m.Name) ? "(ohne Name)" : m.Name!;
    private static string Prozent(double anteil) => (anteil * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + " %";

    public void Dispose() => Fx.Dispose();
}
