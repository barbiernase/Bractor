@*  Generische virtualisierte Liste. Der einzige Ort im System mit IJSRuntime.
    Domänen-Views bleiben dumm: sie geben Window + Row-Vorlage herein, sonst nichts.  *@

@namespace Domain.Client.Modules.Blazor.Shared
@typeparam TItem where TItem : class
@typeparam TKey where TKey : struct
@using global::Client.Infrastructure.Abstractions
@using global::Client.Infrastructure.Collections
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject EffectScope Fx

<style>
    .vl-viewport { height: 100%; overflow-y: auto; position: relative; }
    .vl-row { overflow: hidden; box-sizing: border-box; }
    .vl-row.vl-selected { background: #2a3a50; border-left: 3px solid #5c9eff; }
</style>

<div @ref="_viewport" class="vl-viewport">
    <div style="height:@(TopSpacerPx)px"></div>

    @for (var i = _first; i <= _last; i++)
    {
        var index = i;
        var item = Window[index];
        var selektiert = index == CursorAnzeigeIndex;
        <div @key="index" class="vl-row @(selektiert ? "vl-selected" : null)"
             style="height:@(RowHeight)px"
             @onclick="() => Aktiviere(item)">
            @if (item is not null)
            {
                @Row(item)
            }
            else
            {
                @(Skeleton ?? _leer)
            }
        </div>
    }

    <div style="height:@(BottomSpacerPx)px"></div>
</div>

@code {
    // ─── Vertrag (deklarativ vom Domänen-View gesetzt) ───
    [Parameter, EditorRequired] public StoreBase Store { get; set; } = null!;
    [Parameter, EditorRequired] public IVirtualWindow<TItem> Window { get; set; } = null!;
    [Parameter] public Cursor<TKey>? Cursor { get; set; }
    [Parameter] public int RowHeight { get; set; } = 24;
    [Parameter] public int BufferPages { get; set; } = 2;

    /// <summary>
    /// Erzwingt "nie kompensieren" (Neuzugänge rutschen immer sichtbar rein), auch
    /// wenn nach unten gescrollt. Standard false: am oberen Rand rutscht es rein,
    /// weiter unten wird kompensiert — das ergibt sich aus der Scroll-Position selbst.
    /// </summary>
    [Parameter] public bool StickToTop { get; set; }

    [Parameter, EditorRequired] public RenderFragment<TItem> Row { get; set; } = null!;
    [Parameter] public RenderFragment? Skeleton { get; set; }
    [Parameter] public EventCallback<TItem> OnActivate { get; set; }

    // ─── Interner Zustand (die eine "schlaue" View) ───
    private ElementReference _viewport;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    private int _first;                 // erster sichtbarer Anzeige-Index
    private int _last = -1;             // letzter sichtbarer Anzeige-Index
    private int _letzterInsertOffset;   // für die Offset-Kompensation

    private static readonly RenderFragment _leer = _ => { };

    private int TopSpacerPx    => _first * RowHeight;
    private int BottomSpacerPx => Math.Max(0, (Window.GesamtAnzahl - (_last + 1)) * RowHeight);

    // Cursor.Index wird als STABILER Index interpretiert → Anzeige = stabil + Offset.
    // Dadurch bleibt der Cursor bei Live-Einfügungen oben ohne Zutun fix.
    private int CursorAnzeigeIndex => Cursor is null ? -1 : Cursor.Index + Window.InsertOffset;

    protected override void OnInitialized()
    {
        // Selektive Subscriptions — rendern nur, wenn Window bzw. Cursor sich versionieren.
        Fx.OnChanged(Store, Window, OnWindowChanged);
        if (Cursor is not null)
            Fx.OnChanged(Store, Cursor, OnCursorChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Assembly-Name im Pfad muss zur RCL passen (hier Domain.Client.Modules.Blazor).
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Domain.Client.Modules.Blazor/Shared/VirtualList.razor.js");

        // init() hängt Scroll- + Resize-Listener an und meldet sofort den ersten Bereich.
        _handle = await _module.InvokeAsync<IJSObjectReference>(
            "init", DotNetObjectReference.Create(this), _viewport);
    }

    /// <summary>
    /// Rückkanal aus JS: sichtbarer Bereich hat sich geändert. Hier — und nur hier —
    /// trifft "was ist sichtbar" auf "was fehlt", und nur hier wird BaueQuery dispatcht.
    /// </summary>
    [JSInvokable]
    public void OnViewport(double scrollTop, double height)
    {
        if (RowHeight <= 0 || Window.GesamtAnzahl == 0) return;

        var first = (int)(scrollTop / RowHeight);
        var last  = (int)Math.Ceiling((scrollTop + height) / RowHeight) - 1;
        last  = Math.Min(last, Window.GesamtAnzahl - 1);
        first = Math.Clamp(first, 0, Math.Max(0, last));

        // Prefetch-Puffer über und unter dem Sichtbereich.
        var puffer = BufferPages * Math.Max(1, Window.ChunkGroesse);
        var von = Math.Max(0, first - puffer);
        var bis = Math.Min(Window.GesamtAnzahl - 1, last + puffer);

        foreach (var seite in Window.FehlendeSeiten(von, bis))
        {
            Fx.Dispatch(Window.BaueQuery(seite));   // Query raus (fire-and-forget)
            Window.MarkiereAngefordert(seite);       // Doppel-Requests verhindern
        }

        (_first, _last) = (first, last);
        StateHasChanged();
    }

    private void OnWindowChanged()
    {
        // Live-Insert-Kompensation: wuchs InsertOffset und wir kleben nicht am
        // Live-Rand, verschiebt sich der sichtbare Inhalt optisch nach unten —
        // einmal per scrollTop kompensieren, damit nichts springt.
        var offset  = Window.InsertOffset;
        var zuwachs = offset - _letzterInsertOffset;
        _letzterInsertOffset = offset;

        // Am Live-Rand (ganz oben, _first == 0) NICHT kompensieren → Neuzugänge
        // rutschen sichtbar rein. Weiter unten kompensieren → die gelesene Position
        // bleibt stabil. StickToTop erzwingt "nie kompensieren" auch beim Scrollen.
        if (zuwachs > 0 && !StickToTop && _first > 0 && _handle is not null)
            _ = _handle.InvokeVoidAsync("adjustBy", zuwachs * RowHeight);

        // Erst-Population: sobald GesamtAnzahl das erste Mal bekannt ist (erster
        // Chunk da), einen frischen Viewport-Report anstoßen — der füllt dann den
        // sichtbaren Bereich. Ohne das bliebe die Liste leer, bis man scrollt.
        if (_last < 0 && Window.GesamtAnzahl > 0 && _handle is not null)
            _ = _handle.InvokeVoidAsync("report");

        StateHasChanged();
    }

    private void OnCursorChanged()
    {
        // Cursor-Zeile in den Sichtbereich holen, falls außerhalb.
        var idx = CursorAnzeigeIndex;
        if (idx >= 0 && (idx < _first || idx > _last))
            _ = _handle?.InvokeVoidAsync("scrollToPx", idx * RowHeight);
        StateHasChanged();
    }

    private Task Aktiviere(TItem? item)
        => item is null ? Task.CompletedTask : OnActivate.InvokeAsync(item);

    public async ValueTask DisposeAsync()
    {
        Fx.Dispose();
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* Circuit bereits geschlossen */ }
    }
}
