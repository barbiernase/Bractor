<Project Sdk="Microsoft.NET.Sdk">

  <!-- Die KOMPOSITION der Prüfdomäne (docs/07, Rolle Komposition): Framework + ihre Rollen-Projekte (Schreibseite, Leseseite, Speicher, Abläufe mit den Funktionen). Hier laufen
       die Laufzeit-Generatoren (Infrastructure.SourceGeneration) — ohne Akteure und Leitung emittieren diese Teile leer,
       aber kompilierbar. Die STJ-Kontexte (Serialization/*.g.cs) schreibt der Codegen-Prepass hierher; ohne Leitungs-Projekt hängt der
       Prepass an der Komposition. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pruefdomaene.Laufzeit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Pruefdomaene\Pruefdomaene.csproj" />
    <ProjectReference Include="..\Pruefdomaene.Pipeline\Pruefdomaene.Pipeline.csproj" />
    <ProjectReference Include="..\Pruefdomaene.Projections\Pruefdomaene.Projections.csproj" />
    <ProjectReference Include="..\Pruefdomaene.Infrastructure\Pruefdomaene.Infrastructure.csproj" />
    <ProjectReference Include="..\Infrastructure.SourceGeneration\Infrastructure.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\Cqrs.Codegen\CqrsCodegen.targets" />

</Project>
