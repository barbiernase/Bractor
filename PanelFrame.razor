@using Client.Infrastructure.Abstractions

<div style="display: flex; height: 100%; flex-shrink: 0;">
    @if (Side == SidebarSide.Right) { @Bar() @Content() }
    else { @Content() @Bar() }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public int ExpandedWidth { get; set; } = 180;
    [Parameter] public int CollapsedWidth { get; set; } = 40;
    [Parameter] public SidebarSide Side { get; set; } = SidebarSide.Left;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private int Width => IsExpanded ? ExpandedWidth : CollapsedWidth;
    private async Task Toggle() { IsExpanded = !IsExpanded; await IsExpandedChanged.InvokeAsync(IsExpanded); }

    private RenderFragment Bar() => __builder =>
    {
        <div @onclick="Toggle"
             style="width: 24px; flex-shrink: 0; background: #1a1a1a;
                    border-left: @(Side == SidebarSide.Right ? "1px solid #333" : "none");
                    border-right: @(Side == SidebarSide.Left ? "1px solid #333" : "none");
                    cursor: pointer; display: flex; align-items: center;
                    justify-content: center; user-select: none;">
            <span style="writing-mode: vertical-lr; transform: rotate(180deg);
                         font-size: 11px; font-weight: 600; letter-spacing: 1px;
                         color: #666; text-transform: uppercase;">@Title</span>
        </div>
    };

    private RenderFragment Content() => __builder =>
    {
        <div style="width: @(Width)px; overflow: hidden; transition: width 0.15s ease;
                    background: #1e1e1e;">
            @if (IsExpanded) { @ChildContent }
        </div>
    };
}
