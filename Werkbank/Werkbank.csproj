<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Konfig-Bindung ohne Reflection (Inv. 4) — für den eingebundenen UmgebungLader (wie in Infrastructure). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umgebungen lösen Host und Werkbank mit DERSELBEN Regel auf (Platzhalter, fehlende Variable = Fehler, strenge Bindung) — per Link,
         ohne das Server-Framework (Marten, Proto.Actor) zu referenzieren. -->
    <Compile Include="..\Infrastructure\Umgebung\UmgebungLader.cs" Link="Server\UmgebungLader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- KEINE Domain-Referenz: die Werkbank liest den Code im warmen Workspace (GraphExtractor.Kern) und startet den echten Host
         als eigenen Prozess (Umgebung sim) — keine Simulationsschicht, keine zweite Laufzeit (Werkbank P8). -->
    <!-- Der Editor-Modus: Modell, Grammatik, Scaffolder (Modell → C#). -->
    <ProjectReference Include="../DomainEditor/DomainEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dieselbe Roslyn-Version wie der Extractor-Kern (warmer Workspace). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <!-- Dieselbe Version für alle Roslyn-Pakete (sonst NU1608, der Workspace meldet das als Fehler). -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.3.0" />
    <!-- MSBuildLocator zur Laufzeit; die MSBuild-Assemblies selbst kommen aus dem SDK, nicht aus der Ausgabe. -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Werkbank: Sim-DB verwalten (zurücksetzen, Stände speichern/laden). -->
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Der Extractor-Kern: warmer Workspace (Arbeitsbereich, Werkbank P7.1) und dieselben Feld-Regeln wie der Extractor
         (Codeformen: Code → Modell) für den Abgleich bestehender Deklarationen (Modell → Code). -->
    <ProjectReference Include="../GraphExtractor.Kern/GraphExtractor.Kern.csproj" />
  </ItemGroup>
</Project>
