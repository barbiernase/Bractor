<Project Sdk="Microsoft.NET.Sdk">

  <!-- Analyzer des Frameworks über sich selbst (docs/06 §6.7): nur Analyzer, keine Generatoren — darum
       ein eigenes Projekt; Infrastructure.SourceGeneration liefe im Framework selbst als Laufzeitprojekt an. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 (Analyzer-Release-Tracking) ist für die internen CQRS-Diagnostiken nicht nötig. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
