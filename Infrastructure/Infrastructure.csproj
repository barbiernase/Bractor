<Project Sdk="Microsoft.NET.Sdk">

  <!-- Das Framework: referenziert KEIN Domänen-Projekt. Was es über eine Anwendung wissen muss, bezieht es über IAnwendung
       (Komposition/Anwendung.cs), die die Komposition der Anwendung (<Wurzel>.Laufzeit) generiert und anmeldet (docs/07). -->
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Cqrs.Leitung\Cqrs.Leitung.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="GrpcClient\Actors\" />
    <Folder Include="GrpcClient\Messages\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Marten" Version="8.20.0" />
    <PackageReference Include="Proto.Actor" Version="1.7.0" />
    <PackageReference Include="Proto.Cluster" Version="1.7.0" />
    <PackageReference Include="Proto.Cluster.Consul" Version="1.7.0" />
    <PackageReference Include="Proto.Cluster.TestProvider" Version="1.7.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.10.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Konfig-Bindung ohne Reflection (Inv. 4): der Source-Generator ersetzt ConfigurationBinder.Get<T> (z. B. Quellen-Konfig). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

</Project>
