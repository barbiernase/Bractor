<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Das VERHALTENS-NETZ (docs/12 §12.6): echte Hosts als Prozesse, angesprochen nur von außen — über die
    gRPC-Leitung mit dem echten C#-Client, den JSON-Eingang, das Quell-Verzeichnis und Queries; geprüft wird das fachliche Soll im Log.
    Nichts hier hängt an der Verdrahtung des Frameworks (Broker, Dirigent, Prozess-Events): das Netz soll den Umbau überstehen.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Das fachliche Soll steht im Log: gezählt wird per SQL, nie über das Framework. -->
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jede Klasse fährt eigene Host-Prozesse samt eigener Datenbank; nie zwei gleichzeitig. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Der Client, wie ihn der Blazor-Arbeitsplatz fährt: Bus, Verbindung, Query-Brücke, Versionen und sein generiertes Wiring. -->
    <ProjectReference Include="..\Client.Infrastructure\Client.Infrastructure.csproj" />
    <ProjectReference Include="..\Domain.Client.Modules.Blazor\Domain.Client.Modules.Blazor.csproj" />
    <!-- Die Leitung der Anwendung (Nutzlast-Tabelle) und damit die Nachrichten-Typen der Beispieldomäne. -->
    <ProjectReference Include="..\Domain.Leitung\Domain.Leitung.csproj" />
    <!-- Die Fakten der Prüfdomäne (nur ihre Typnamen zählen im Log; gesprochen wird über den JSON-Eingang). -->
    <ProjectReference Include="..\Pruefdomaene\Pruefdomaene.csproj" />
    <!-- Nur die Build-Reihenfolge: die Hosts laufen als eigene Prozesse (Black-Box), sie werden nicht geladen. -->
    <ProjectReference Include="..\Host.Grpc\Host.Grpc.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Host.Pruefdomaene\Host.Pruefdomaene.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
