<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Domain.Leitung</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.59.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.59.0" />
    <PackageReference Include="Grpc.Tools" Version="2.59.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="domain.proto" GrpcServices="None" />
  </ItemGroup>

  <!-- Die Leitung der Anwendung (docs/07, Rolle Leitung): die Domänen-DTOs aus domain.proto und ihr generierter Nutzlast-Mapper
       (GeneratedNutzlast : Cqrs.Leitung.INutzlastTabelle, DtoMapperSourceGenerator) — für Server-Komposition und C#-Client. -->
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Cqrs.Leitung\Cqrs.Leitung.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Domain.Projections\Domain.Projections.csproj" />
    <ProjectReference Include="..\Domain.Pipeline\Domain.Pipeline.csproj" />
    <ProjectReference Include="..\Infrastructure.SourceGeneration\Infrastructure.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- CODEGEN-PREPASS der Anwendung (Cqrs.Codegen/CqrsCodegen.targets): hier, weil dieses Projekt der erste Consumer ist (domain.proto
       vor protoc) und — anders als die Domain-Projekte selbst — Cqrs.Codegen referenzieren darf (kein Zyklus: Cqrs.Codegen referenziert
       Domain, nicht Domain.Leitung). Reihenfolge: Codegen-Projekte (Projektstruktur) → Cqrs.Codegen → Domain.Leitung (Prepass, protoc)
       → Domain.Laufzeit (STJ-Kontexte). -->
  <Import Project="..\Cqrs.Codegen\CqrsCodegen.targets" />

</Project>
       