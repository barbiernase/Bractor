{
  "Umgebung": {
    "Name": "sim-main",
    "Art": "Sim",
    "Python": "/opt/miniconda3/envs/gpu_env/bin/python"
  },
  "EventStore": {
    "Betrieb": "Verwaltet",
    "Verbindung": "Host=localhost;Port=5432;Username=postgres;Password=postgres",
    "Datenbank": "cqrs_sim_${branch}",
    "Schema": "es"
  },
  "Cluster": {
    "Art": "Einzelknoten",
    "Name": "cqrs-sim-${branch}"
  },
  "Transport": {
    "GrpcPort": 5101,
    "EinblickPort": 5102,
    "JsonEingang": true
  },
  "Identitaeten": {
    "Tokens": {
      "sim-bildrechner": "Bildrechner",
      "sim-disponent": "Disponent",
      "sim-inspekteur": "Inspekteur",
      "sim-kioperator": "KIOperator",
      "sim-kamerasystem": "KameraSystem",
      "sim-klassifizierer": "Klassifizierer",
      "sim-modellfreigeber": "Modellfreigeber",
      "sim-produktpruefer": "Produktpruefer",
      "sim-arbeitsplatz": "Inspekteur,KIOperator,Modellfreigeber,Produktpruefer",
      "sim-trainingssystem": "TrainingsSystem"
    }
  },
  "Clients": {
    "Arbeitsplatz": {
      "Token": "sim-arbeitsplatz",
      "Urls": "http://localhost:5110",
      "Dateien": [
        "${env:HOME}/cqrs-sim/${branch}/DateiErkannt",
        "${env:HOME}/cqrs-sim/${branch}/preprocessed"
      ]
    }
  }
}
