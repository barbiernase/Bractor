{
  "Umgebung": {
    "Name": "vermessung",
    "Art": "Prod",
    "Python": "/opt/miniconda3/envs/gpu_env/bin/python"
  },
  "EventStore": {
    "Betrieb": "Vorhanden",
    "Verbindung": "Host=localhost;Port=5432;Username=postgres;Password=postgres",
    "Datenbank": "cqrs_vermessung",
    "Schema": "es"
  },
  "Cluster": {
    "Art": "Consul",
    "Name": "cqrs-vermessung",
    "Consul": "localhost:8500",
    "AdvertisedHost": "localhost",
    "Rechner": "messrechner"
  },
  "Transport": {
    "GrpcPort": 5201,
    "EinblickPort": 5202,
    "JsonEingang": true
  },
  "Identitaeten": {
    "Tokens": {
      "vermessung-reaktionsworker": "Datensatzpfleger,Teilmelder",
      "vermessung-kamerasystem": "KameraSystem",
      "vermessung-disponent": "Disponent",
      "vermessung-kioperator": "KIOperator",
      "vermessung-inspekteur": "Inspekteur",
      "vermessung-arbeitsplatz": "Inspekteur,KIOperator,Modellfreigeber,Produktpruefer"
    }
  },
  "Clients": {
    "Linienrechner": {
      "Eingaenge": {
        "linie1": {
          "Art": "Dateiwaechter",
          "Akteur": "KameraSystem",
          "Rechner": "messrechner",
          "Pfad": "${env:HOME}/cqrs-vermessung/DateiErkannt",
          "Muster": [
            "*.tiff"
          ],
          "Intervall": "00:00:01",
          "Fertig": "Stabil",
          "Fenster": "00:00:01",
          "Kennung": "NameGroesse"
        }
      }
    }
  }
}
