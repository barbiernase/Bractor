{
  "Graph": "Linienimport",
  "Akteur": "KameraSystem",
  "Eingang": {
    "Pfad": "${env:HOME}/cqrs-vermessung/DateiErkannt",
    "Muster": [
      "*.tiff"
    ],
    "Intervall": "00:00:01",
    "Fertig": "Stabil",
    "Fenster": "00:00:01",
    "Kennung": "NameGroesse"
  },
  "Aufbereitung.Einlesen": {
    "Laufort": "Host",
    "Wiederholungen": 1,
    "Worker": {
      "Skript": "Domain.Client.Worker.Python.ML/funktions_worker.py",
      "Argumente": [
        "--funktionen",
        "IBildEinlesen",
        "--slots",
        "2",
        "--konfig",
        "AusgabePfad=${env:HOME}/cqrs-vermessung/preprocessed"
      ],
      "Token": "vermessung-bildrechner"
    }
  },
  "Aufbereitung.Verkleinern": {
    "Laufort": "Host",
    "Wiederholungen": 1,
    "Worker": {
      "Skript": "Domain.Client.Worker.Python.ML/funktions_worker.py",
      "Argumente": [
        "--funktionen",
        "IBildVerkleinerung",
        "--slots",
        "2",
        "--konfig",
        "AusgabePfad=${env:HOME}/cqrs-vermessung/preprocessed"
      ],
      "Token": "vermessung-bildrechner"
    },
    "AusgabePfad": "${env:HOME}/cqrs-vermessung/preprocessed"
  },
  "Aufbereitung.Kontrast": {
    "Laufort": "Host",
    "Wiederholungen": 1,
    "Worker": {
      "Skript": "Domain.Client.Worker.Python.ML/funktions_worker.py",
      "Argumente": [
        "--funktionen",
        "IKontrastausgleich",
        "--slots",
        "2",
        "--konfig",
        "AusgabePfad=${env:HOME}/cqrs-vermessung/preprocessed"
      ],
      "Token": "vermessung-bildrechner"
    },
    "AusgabePfad": "${env:HOME}/cqrs-vermessung/preprocessed"
  }
}
