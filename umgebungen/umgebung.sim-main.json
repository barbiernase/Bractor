{
  "Umgebung": {
    "Name": "sim-main",
    "Art": "Sim"
  },
  "EventStore": {
    "Betrieb": "Verwaltet",
    "Verbindung": "Host=localhost;Port=5432;Username=postgres;Password=postgres",
    "Datenbank": "cqrs_sim_${branch}",
    "Schema": "es"
  },
  "VersionIndex": {
    "Betrieb": "Verwaltet",
    "Endpunkt": "localhost:6379",
    "Datenbank": 1,
    "Praefix": "sim:${branch}:"
  },
  "Cluster": {
    "Art": "Einzelknoten",
    "Name": "cqrs-sim-${branch}"
  },
  "Transport": {
    "GrpcPort": 5101,
    "EinblickPort": 5102,
    "JsonEingang": true
  },
  "Identitaeten": {
    "Tokens": {
      "sim-bildrechner": "Bildrechner",
      "sim-disponent": "Disponent",
      "sim-inspekteur": "Inspekteur",
      "sim-kioperator": "KIOperator",
      "sim-kamerasystem": "KameraSystem",
      "sim-klassifizierer": "Klassifizierer",
      "sim-modellfreigeber": "Modellfreigeber",
      "sim-produktpruefer": "Produktpruefer",
      "sim-arbeitsplatz": "Inspekteur,KIOperator,Modellfreigeber,Produktpruefer",
      "sim-trainingssystem": "TrainingsSystem"
    }
  },
  "Quellen": {
    "DateiErkannt": {
      "Pfad": "${env:HOME}/cqrs-sim/${branch}/DateiErkannt",
      "Intervall": "00:00:01",
      "Fertig": {
        "Art": "Stabil",
        "Fenster": "00:00:01"
      },
      "Kennung": "PfadGroesseZeit",
      "Laufmodus": "EinmalImCluster",
      "Webhook": "/webhook/datei"
    }
  },
  "Funktionen": {
    "IBildVerkleinerung": {
      "Laufort": "Host",
      "Slots": 2,
      "Wiederholungen": 1,
      "Worker": {
        "Skript": "Domain.Client.Worker.Python.ML/funktions_worker.py",
        "Argumente": [
          "--funktionen",
          "IBildVerkleinerung",
          "--konfig",
          "AusgabePfad=${env:HOME}/cqrs-sim/${branch}/preprocessed"
        ],
        "Token": "sim-bildrechner"
      }
    },
    "IHistogrammAusgleich": {
      "Laufort": "Host",
      "Slots": 2,
      "Wiederholungen": 1,
      "Worker": {
        "Skript": "Domain.Client.Worker.Python.ML/funktions_worker.py",
        "Argumente": [
          "--funktionen",
          "IHistogrammAusgleich",
          "--konfig",
          "AusgabePfad=${env:HOME}/cqrs-sim/${branch}/preprocessed"
        ],
        "Token": "sim-bildrechner"
      }
    },
    "IDateinameDeutung": {
      "Laufort": "Host",
      "Slots": 8
    },
    "IRangeSuche": {
      "Laufort": "Host",
      "Slots": 2
    },
    "IMitgliederEinfrieren": {
      "Laufort": "Host",
      "Slots": 2
    }
  },
  "Clients": {
    "Arbeitsplatz": {
      "Token": "sim-arbeitsplatz",
      "Urls": "http://localhost:5110",
      "Dateien": [
        "${env:HOME}/cqrs-sim/${branch}/DateiErkannt",
        "${env:HOME}/cqrs-sim/${branch}/preprocessed"
      ]
    }
  },
  "Konfig": {
    "BildaufbereitungKonfig": {
      "AusgabePfad": "${env:HOME}/cqrs-sim/${branch}/preprocessed"
    }
  }
}
